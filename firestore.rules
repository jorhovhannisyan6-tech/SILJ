rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users profile collection
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'jor.hovhannisyan6@gmail.com');
    }

    // Dynamic policy rules
    match /dynamic_policy_rules/{ruleId} {
      allow read, write: if true;
    }

    // Bot configurations
    match /bot_configs/{configId} {
      allow read, write: if true;
    }

    // DOCX quotation template mappings
    match /docx_template_mappings/{mappingId} {
      allow read, write: if true;
    }

    // DOCX contract template mappings
    match /docx_contract_mappings/{mappingId} {
      allow read, write: if true;
    }

    // DOCX quotation templates metadata
    match /docx_templates_meta/{metaId} {
      allow read, write: if true;
    }

    // DOCX contract templates metadata
    match /docx_contract_templates_meta/{metaId} {
      allow read, write: if true;
    }

    // Knowledge base documents
    match /knowledge_base_docs/{docId} {
      allow read, write: if true;
    }

    // Knowledge base embeddings cache
    match /kb_embeddings_cache/{docId} {
      allow read, write: if true;
    }

    // Quotations & Proposals collection (shared among SIL agents)
    match /quotations/{quoteId} {
      allow read, write: if true;
    }

    // Contracts & Issued Policies collection
    match /contracts/{contractId} {
      allow read, write: if true;
    }

    // Client Directory collection
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Backup snapshots
    match /backup_snapshots/{backupId} {
      allow read, write: if true;
    }

    // System audit logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}

